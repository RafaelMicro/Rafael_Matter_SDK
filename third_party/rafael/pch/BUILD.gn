import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")

import("pch.gni")

if (rt58x_use_pch) {
  _pch_dir = "${target_gen_dir}/pch"

  action("chip_pch") {
    script = "build_pch.py"
    inputs = [ "chip_pch.h" ]

    outputs = [
      "${_pch_dir}/chip_pch.h.gch",
      "${_pch_dir}/chip_pch.h",
    ]
    depfile = "${_pch_dir}/chip_pch.h.gch.d"

    args = [
      "--header",
      rebase_path("chip_pch.h", root_build_dir),
      "--out-dir",
      rebase_path(_pch_dir, root_build_dir),
      "--depfile",
      rebase_path(depfile, root_build_dir),

      "--reference-source",
      "src/platform/RT58x/SystemTimeSupport.cpp",
    ]
    deps = [
      "${chip_root}/src/access:access_config",
      "${chip_root}/src/app:app_config",
      "${chip_root}/src/app/icd/server:icd-server-config",
      "${chip_root}/src/ble:ble_config_header",
      "${chip_root}/src/crypto:crypto_buildconfig",
      "${chip_root}/src/inet:inet_config_header",
      "${chip_root}/src/lib/asn1:asn1oid_header",
      "${chip_root}/src/lib/core:chip_config_header",
      "${chip_root}/src/platform:platform_config_header",
      "${chip_root}/src/setup_payload:additional_data_payload_buildconfig",

      "${chip_root}/src/system:system_buildconfig",
    ]
  }

  config("chip_pch_config") {
    include_dirs = [ _pch_dir ]
    cflags_cc = [
      "-include",
      "chip_pch.h",
      "-Winvalid-pch",
      "-Wno-error=invalid-pch",
    ]
  }
} else {
  group("chip_pch") {
  }

  config("chip_pch_config") {
  }
}
