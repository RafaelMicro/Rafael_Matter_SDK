import("//build_overrides/chip.gni")
import("//build_overrides/pigweed.gni")
import("//build_overrides/rt58x_sdk.gni")

import("${chip_root}/examples/platform/rt58x/args.gni")

arm_platform_config = "${rt58x_sdk_build_root}/rt58x_arm.gni"

mbedtls_target = "${chip_root}/third_party/rafael:mbedtls"
openthread_external_mbedtls = mbedtls_target

# Matter 1.6 added an assert to src/crypto/crypto.gni forbidding it from being
# imported from args.gni, so the old `if (chip_crypto == "")` guard is gone.
# A plain assignment here is still overridable from the gn command line, which
# takes precedence over args.gni. Every 1.6 platform args.gni does it this way.
chip_crypto = "mbedtls"

chip_device_platform = "rt58x"

#Net work configuration OpenThread
lwip_platform = "rt58x"
chip_mdns = "platform"
chip_inet_config_enable_ipv4 = false
chip_inet_config_enable_tcp_endpoint = false
chip_inet_config_enable_udp_endpoint = true
chip_system_config_use_openthread_inet_endpoints = true
chip_with_lwip = false
optimize_debug_level = "s"

chip_build_tests = false

chip_enable_push_av_stream_transport = false

chip_enable_thread = true
openthread_root = "${chip_root}/third_party/openthread/openthread-rafael/openthread"

openthread_core_config_platform_check_file = ""

openthread_project_core_config_file = "OpenThreadConfig.h"

openthread_core_config_deps = [ "${chip_root}/examples/platform/rt58x:openthread_core_config_rt58x_chip_examples" ]

chip_config_memory_management = "platform"

pw_build_LINK_DEPS = [
  "$dir_pw_assert:impl",
  "$dir_pw_log:impl",
]
